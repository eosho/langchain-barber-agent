# ================================
# Barbershop Booking Agent Config
# ================================

# Application
APP_NAME="Barbz"
APP_VERSION="0.1.0"
ENVIRONMENT="development"  # development, staging, production
DEBUG=true

# LLM Configuration
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4"
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1000

# LangSmith (optional - for observability)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY="your-langsmith-api-key-here"
LANGCHAIN_PROJECT="barbershop-booking-agent"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"

# FastAPI Configuration
API_HOST="0.0.0.0"
API_PORT=8005
API_RELOAD=true
API_WORKERS=1

# Chainlit Configuration
CHAINLIT_HOST="0.0.0.0"
CHAINLIT_PORT=8006
CHAINLIT_AUTH_SECRET="your-secret-key-here-change-in-production"

# Database Configuration
DATABASE_URL="sqlite+aiosqlite:///./barbershop.db"
# For PostgreSQL use:
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/barbershop"

# Database Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# CORS Settings
CORS_ORIGINS=["http://localhost:8005", "http://localhost:3000"]
CORS_CREDENTIALS=true
CORS_METHODS=["*"]
CORS_HEADERS=["*"]

# Agent Configuration
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=60
CONVERSATION_MEMORY_WINDOW=10  # Number of messages to keep in memory

# Business Configuration (Mock Data)
BUSINESS_NAME="Tony's Barbershop"
BUSINESS_PHONE="+1-555-0100"
BUSINESS_EMAIL="info@tonysbarbershop.com"
BUSINESS_ADDRESS="123 Main Street, Anytown, USA"
BUSINESS_TIMEZONE="America/New_York"

# Operating Hours (JSON format - by day of week, 0=Monday, 6=Sunday)
BUSINESS_HOURS='{"0": {"open": "09:00", "close": "20:00"}, "1": {"open": "09:00", "close": "20:00"}, "2": {"open": "09:00", "close": "20:00"}, "3": {"open": "09:00", "close": "20:00"}, "4": {"open": "09:00", "close": "20:00"}, "5": {"open": "09:00", "close": "20:00"}, "6": {"open": "10:00", "close": "18:00"}}'

# Booking Configuration
BOOKING_SLOT_DURATION_MINUTES=30
BOOKING_ADVANCE_DAYS=14  # How many days in advance can customers book
CANCELLATION_NOTICE_HOURS=24  # Required notice for cancellations
SAME_DAY_BOOKING_CUTOFF_HOUR=14  # Latest hour for same-day bookings (24-hour format)

# Logging
LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT="json"  # json or text
LOG_FILE="logs/barbershop.log"

# Security
SECRET_KEY="your-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60
